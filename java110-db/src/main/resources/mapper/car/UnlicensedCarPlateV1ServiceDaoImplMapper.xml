<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="unlicensedCarPlateV1ServiceDaoImpl">

    <insert id="saveUnlicensedCarPlateInfo" parameterType="Map">
        insert into unlicensed_car_plate(
        plate_id,open_id,car_num,community_id,open_type
        ) values (
        #{plateId},#{openId},#{carNum},#{communityId},#{openType}
        )
    </insert>

    <select id="getUnlicensedCarPlateInfo" parameterType="Map" resultType="Map">
        select t.plate_id plateId,t.open_id openId,t.car_num carNum,t.community_id communityId,
        t.open_type openType,t.status_cd statusCd,t.create_time createTime
        from unlicensed_car_plate t
        where 1=1
        <if test="openId !=null and openId != ''">
            and t.open_id= #{openId}
        </if>
        <if test="carNum !=null and carNum != ''">
            and t.car_num= #{carNum}
        </if>
        <if test="statusCd !=null and statusCd != ''">
            and t.status_cd= #{statusCd}
        </if>
        order by t.create_time desc
        <if test="page != -1 and page != null ">
            limit #{page}, #{row}
        </if>
    </select>

    <select id="queryUnlicensedCarPlateCount" parameterType="Map" resultType="Map">
        select count(1) count
        from unlicensed_car_plate t
        where 1=1
    </select>

</mapper>
