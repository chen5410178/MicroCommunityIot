                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>com.java110</groupId>
            <artifactId>iot-job</artifactId>
            <version>${hc.version}</version>
            <exclusions>
                <exclusion>
                    <artifactId>java110-service</artifactId>
                    <groupId>com.java110</groupId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>com.java110</groupId>
